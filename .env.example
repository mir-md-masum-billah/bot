# Telegram
BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather
BOT_USERNAME=your_bot_username

# MongoDB (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/promo_bot?retryWrites=true&w=majority

# Public URL of your deployment (Vercel or Railway), no trailing slash
PUBLIC_URL=https://your-app.vercel.app

# Secret path segment for the webhook route (keep this secret/random)
WEBHOOK_SECRET=change-this-to-a-random-string

# Admin dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Commission percentage applied to earned (non-donated) coins used for promotion
EARNED_COMMISSION_PERCENT=10

# How many GRAM coins one Telegram Star is "worth" when a user pays for a
# task with Stars instead of GRAM balance. There's no official published
# rate for this — pick whatever exchange rate you actually want to offer.
GRAM_PER_STAR=2000
