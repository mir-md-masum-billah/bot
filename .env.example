# Telegram
BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather
BOT_USERNAME=your_bot_username

# MongoDB (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/promo_bot?retryWrites=true&w=majority

# Public URL of your deployment (Vercel or Railway), no trailing slash
PUBLIC_URL=https://your-app.vercel.app

# Secret path segment for the webhook route (keep this secret/random)
WEBHOOK_SECRET=change-this-to-a-random-string

# Admin dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Commission percentage applied to earned (non-donated) coins used for promotion
EARNED_COMMISSION_PERCENT=10

# How many GRAM coins one Telegram Star is "worth" when a user pays for a
# task with Stars instead of GRAM balance. There's no official published
# rate for this — pick whatever exchange rate you actually want to offer.
GRAM_PER_STAR=2000

# Bot-task screenshot proof: how long a pending submission waits for the
# task owner to approve/reject before the cron route auto-approves it.
PROOF_AUTO_APPROVE_HOURS=24

# Secret query param for pages/api/cron/auto-approve-submissions.js.
# Point an external scheduler (Vercel Cron, cron-job.org, etc.) at
# https://your-app.vercel.app/api/cron/auto-approve-submissions?secret=...
# every 10-15 minutes. Falls back to WEBHOOK_SECRET if unset.
CRON_SECRET=change-this-to-a-different-random-string

# Telegram user IDs (comma separated) that get a private message in the bot
# whenever a user files a new report or replies to one. Optional but
# recommended — you must have pressed /start on the bot yourself.
ADMIN_TELEGRAM_IDS=123456789

# Optional: separate secret for signing the admin login cookie.
# Falls back to WEBHOOK_SECRET. One of the two MUST be set.
ADMIN_SESSION_SECRET=change-this-to-another-random-string
